# MarkVault 环境变量示例
# 复制为 .env 后由 Docker Compose 读取：cp .env.example .env
# PowerShell 用：Copy-Item .env.example .env
#
# 只有 scripts/go.mjs 包装的 pnpm 脚本会读取 .env；纯 Go 二进制不读取该文件。
# 原生运行时的默认数据目录是 .data/go，而本示例的 MARKVAULT_DATA_DIR=./data/go
# 用于 Compose 绑定挂载，可自行覆盖为其他目录。

# 镜像：默认跟随 GHCR 最新构建；生产环境建议固定明确版本标签或摘要。
# 本地源码构建请改成自己的标签，例如 markvault:local，不要让本地构建覆盖 ghcr.io/xinmang/markvault:latest。
MARKVAULT_IMAGE=ghcr.io/xinmang/markvault:latest

# 宿主机绑定地址与端口：默认只监听本机，公网部署请走反向代理。
APP_BIND=127.0.0.1
APP_PORT=8787

# 宿主机数据目录，挂载到容器 /data，是唯一的数据绑定。
# Linux 首次启动前先创建并交给容器用户，否则首启会因权限失败：
#   mkdir -p data/go && sudo chown 1000:1000 data/go
MARKVAULT_DATA_DIR=./data/go

# 仅源码构建（docker compose build / up --build）时生效的构建镜像。
# Docker Hub 受限时可改为镜像源，例如 mirror.gcr.io/library/node:24-bookworm-slim。
NODE_IMAGE=node:24-bookworm-slim
GO_IMAGE=golang:1.27.4-bookworm
RUNTIME_IMAGE=debian:bookworm-slim

# 首个账号注册成功后自动关闭，之后由管理员在设置中控制；false 强制关闭且不允许界面开启。
ALLOW_REGISTRATION=true

# 令牌有效期：访问令牌默认 15 分钟，刷新令牌默认 30 天。
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# 快照与封面图总容量上限，单位为字节；默认 7516192768（约 7 GiB），0 表示不限制。
STORAGE_MAX_TOTAL_BYTES=7516192768

# 跨域来源精确白名单，多个完整来源用逗号分隔，例如 chrome-extension://扩展ID。
# 留空时不允许跨域客户端（含扩展）访问，不支持 * 通配。
CORS_ALLOWED_ORIGINS=

# 实例密钥：留空时由 Go 服务首次启动生成并持久化到 <数据目录>/config/runtime.env。
# 填入非空值会覆盖已保存的值；不要随意更换 ENCRYPTION_KEY，否则已保存的 AI Key 无法解密。
JWT_SECRET=
ENCRYPTION_KEY=

# 站内 Agent 与 MCP：是否允许自定义 AI 服务访问私网地址，使用本地模型时才显式开启。
AI_ALLOW_PRIVATE_ENDPOINTS=false

# 单次聊天最多执行的只读工具轮数，范围 1-20。
AI_CHAT_MAX_TOOL_ROUNDS=6

# 可信反向代理地址（逗号分隔的 IP 或 CIDR）。只有来自这些地址的请求才读取 X-Forwarded-For，
# 用于按真实客户端限流；留空时按 TCP 来源地址限流。Docker 默认网段示例：172.16.0.0/12
MARKVAULT_TRUSTED_PROXIES=

# 首个成功注册的账号自动成为管理员，后续账号均为普通用户，无需配置账号 ID。

# 可选脚本插件运行时（必须为 Deno 2.9.8；Docker 主镜像已内置）
MARKVAULT_DENO_PATH=
# 管理员逐项允许的内网 MCP HTTPS 来源，逗号分隔，默认不允许
MARKVAULT_PLUGIN_PRIVATE_TARGETS=
