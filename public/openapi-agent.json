{
  "openapi": "3.1.0",
  "info": {
    "title": "MarkVault Agent API",
    "version": "1.2.0",
    "summary": "面向 AI Agent 的 MarkVault 稳定读写接口",
    "description": "使用 X-API-Key 查询和整理当前账户的书签与标签。每个端点都校验细粒度权限；建议由 Agent 在执行写请求前取得用户明确确认。插件停用时对应能力不可用。第三方工具还需要用户开放及 API Key 精确工具授权，既有 Key 不自动获得新工具权限。"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/",
      "description": "当前 MarkVault 实例"
    }
  ],
  "tags": [
    {
      "name": "Agent",
      "description": "稳定、细粒度权限控制的 Agent 接口"
    }
  ],
  "paths": {
    "/api/v1/agent": {
      "get": {
        "tags": ["Agent"],
        "operationId": "getAgentCapabilityIndex",
        "summary": "获取 Agent API 能力索引",
        "security": [],
        "responses": {
          "200": {
            "description": "能力索引",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentIndexResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/me": {
      "get": {
        "tags": ["Agent"],
        "operationId": "getAgentAccount",
        "summary": "验证连接并读取账户统计",
        "description": "需要 user.read 权限。",
        "responses": {
          "200": {
            "description": "账户与 API Key 权限信息",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/agent/search": {
      "get": {
        "tags": ["Agent"],
        "operationId": "searchAgentBookmarks",
        "summary": "搜索书签与标签",
        "description": "搜索书签标题、描述、网址、私人备注和标签名，并返回名称匹配的标签。需要 bookmarks.read 权限。",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "搜索关键词",
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "书签与标签各自的最大返回数量",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "搜索结果",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/agent/bookmarks": {
      "get": {
        "tags": ["Agent"],
        "operationId": "listAgentBookmarks",
        "summary": "分页列出和筛选书签",
        "description": "需要 bookmarks.read 权限。多个标签 ID 表示书签必须同时包含全部标签。",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "description": "搜索标题、描述、网址和私人备注",
            "schema": { "type": "string" }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "逗号分隔的标签 ID",
            "schema": { "type": "string" },
            "example": "tag-id-1,tag-id-2"
          },
          {
            "name": "sort",
            "in": "query",
            "description": "排序方式",
            "schema": {
              "type": "string",
              "enum": ["created", "updated", "pinned", "popular"],
              "default": "created"
            }
          },
          {
            "name": "pinned",
            "in": "query",
            "description": "只返回置顶或非置顶书签",
            "schema": { "type": "boolean" }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "每页数量",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100 }
          },
          {
            "name": "page_cursor",
            "in": "query",
            "description": "上一页 next_cursor 的原始值",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "书签列表与分页信息",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookmarkListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "post": {
        "tags": ["Agent"],
        "operationId": "createAgentBookmark",
        "summary": "创建书签",
        "description": "需要 bookmarks.create 权限。关联 tag_ids 还需要 tags.assign；使用 tags 名称还需要 tags.create。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateBookmarkRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "书签已创建或从回收站恢复",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookmarkResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/agent/bookmarks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Agent"],
        "operationId": "getAgentBookmark",
        "summary": "读取书签详情",
        "description": "需要 bookmarks.read 权限。",
        "responses": {
          "200": {
            "description": "书签详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookmarkResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "patch": {
        "tags": ["Agent"],
        "operationId": "updateAgentBookmark",
        "summary": "修改书签",
        "description": "需要 bookmarks.update 权限。只提交需要改变的字段。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateBookmarkRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改后的书签",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookmarkResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "delete": {
        "tags": ["Agent"],
        "operationId": "deleteAgentBookmark",
        "summary": "将书签移入回收站",
        "description": "需要 bookmarks.delete 权限。此操作为可恢复的软删除。",
        "responses": {
          "204": { "description": "已移入回收站" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/agent/bookmarks/{id}/restore": {
      "patch": {
        "tags": ["Agent"],
        "operationId": "restoreAgentBookmark",
        "summary": "恢复书签",
        "description": "需要 bookmarks.update 权限。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "恢复后的书签",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookmarkResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/agent/tab-groups": {
      "get": {
        "tags": ["Agent"],
        "operationId": "listAgentTabGroups",
        "summary": "分页读取标签页组和条目",
        "description": "需要 tab_groups.read；条目 ID 来自 data.tab_groups[].items[].id，不是组 ID。",
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "page_cursor",
            "in": "query",
            "description": "上一页 data.meta.next_cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "分页读取标签页组和条目",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TabGroupListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/agent/bookmarks/{id}/notes": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "书签 ID",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": ["Agent"],
        "operationId": "listAgentBookmarkNotes",
        "summary": "分页读取书签备注",
        "description": "需要 bookmarks.read；置顶优先，组内按创建时间倒序。",
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "page_cursor",
            "in": "query",
            "description": "上一页 data.meta.next_cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "分页读取书签备注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "tags": ["Agent"],
        "operationId": "addAgentBookmarkNote",
        "summary": "追加书签备注",
        "description": "需要 bookmarks.note；若没有 bookmarks.read，仅返回 data.note.id。每个目标最多 1000 条。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNoteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "追加书签备注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/agent/tab-groups/items/{id}/notes": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "标签页 ID（items[].id）",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": ["Agent"],
        "operationId": "listAgentTabItemNotes",
        "summary": "分页读取标签页备注",
        "description": "需要 tab_groups.read；置顶优先，组内按创建时间倒序。",
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "page_cursor",
            "in": "query",
            "description": "上一页 data.meta.next_cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "分页读取标签页备注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "tags": ["Agent"],
        "operationId": "addAgentTabItemNote",
        "summary": "追加标签页备注",
        "description": "需要 tab_groups.note；若没有 tab_groups.read，仅返回 data.note.id。每个目标最多 1000 条。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNoteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "追加标签页备注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/agent/notes/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "备注 ID",
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "tags": ["Agent"],
        "operationId": "updateAgentNote",
        "summary": "修改备注内容或置顶状态",
        "description": "需要所属目标的 bookmarks.update 或 tab_groups.update。没有对应读取权限时只返回 data.note.id。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改备注内容或置顶状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "tags": ["Agent"],
        "operationId": "deleteAgentNote",
        "summary": "永久删除一条备注",
        "description": "需要所属目标的 bookmarks.update 或 tab_groups.update。",
        "responses": {
          "204": {
            "description": "永久删除一条备注"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/agent/tags": {
      "get": {
        "tags": ["Agent"],
        "operationId": "listAgentTags",
        "summary": "列出标签及书签数量",
        "description": "需要 tags.read 权限。",
        "responses": {
          "200": {
            "description": "标签列表",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "post": {
        "tags": ["Agent"],
        "operationId": "createAgentTag",
        "summary": "创建标签",
        "description": "需要 tags.create 权限。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTagRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "标签已创建",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v1/agent/tags/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Agent"],
        "operationId": "getAgentTag",
        "summary": "读取标签详情",
        "description": "需要 tags.read 权限。",
        "responses": {
          "200": {
            "description": "标签详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "patch": {
        "tags": ["Agent"],
        "operationId": "updateAgentTag",
        "summary": "修改标签",
        "description": "需要 tags.update 权限。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTagRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改后的标签",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "delete": {
        "tags": ["Agent"],
        "operationId": "deleteAgentTag",
        "summary": "删除标签",
        "description": "需要 tags.delete 权限。删除后会解除标签与书签之间的关联。",
        "responses": {
          "204": { "description": "标签已删除" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "在 MarkVault 设置中创建的细粒度权限 API Key"
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "当前限流窗口的请求上限",
        "schema": { "type": "integer" }
      },
      "RateLimitRemaining": {
        "description": "当前限流窗口剩余请求数",
        "schema": { "type": "integer" }
      },
      "RateLimitReset": {
        "description": "当前限流窗口重置时间（Unix 秒）",
        "schema": { "type": "integer" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数无效",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "API Key 缺失、无效、过期或已撤销",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "API Key 缺少所需权限",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "目标不存在或不属于当前账户",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "RateLimited": {
        "description": "达到 API Key 调用限制",
        "headers": {
          "Retry-After": {
            "description": "建议等待秒数",
            "schema": { "type": "integer" }
          },
          "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
          "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
          "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": {}
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ApiError" }
        }
      },
      "BookmarkTag": {
        "type": "object",
        "required": ["id", "name", "color"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": ["string", "null"] }
        }
      },
      "BookmarkScreenshot": {
        "type": "object",
        "description": "浏览器扩展生成的网站截图（帖子正文与图片的图文卡片），每个书签最多一张。",
        "required": ["id", "url", "width", "height", "file_size", "mime_type", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "url": {
            "type": "string",
            "description": "带签名的相对地址，有效期 1–2 小时，每次读取书签时重新签发"
          },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "file_size": { "type": "integer", "minimum": 1 },
          "mime_type": { "type": "string", "enum": ["image/webp", "image/png", "image/jpeg"] },
          "created_at": { "type": "string" }
        }
      },
      "Note": {
        "type": "object",
        "required": [
          "id",
          "content",
          "source",
          "source_name",
          "is_pinned",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "去除首尾空白后，最多 2000 个 Unicode 码点。"
          },
          "source": {
            "enum": ["user", "agent"]
          },
          "source_name": {
            "type": "string"
          },
          "is_pinned": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "bookmark_id": {
            "type": "string"
          },
          "tab_item_id": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "CreateNoteRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "去除首尾空白后，最多 2000 个 Unicode 码点。"
          },
          "is_pinned": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UpdateNoteRequest": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "去除首尾空白后，最多 2000 个 Unicode 码点。"
          },
          "is_pinned": {
            "type": "boolean"
          }
        },
        "minProperties": 1,
        "additionalProperties": false
      },
      "NoteWriteResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["note"],
            "properties": {
              "note": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Note"
                  },
                  {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                      "id": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        }
      },
      "NotePageMeta": {
        "type": "object",
        "required": ["page_size", "count", "has_more"],
        "properties": {
          "page_size": {
            "type": "integer",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "NoteListResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["notes", "meta"],
            "properties": {
              "notes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Note"
                }
              },
              "meta": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/NotePageMeta"
                  },
                  {
                    "type": "object",
                    "required": ["total"],
                    "properties": {
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "TabGroupListResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["tab_groups", "meta"],
            "properties": {
              "tab_groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title", "items"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "title", "url", "note_count", "notes"],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "note_count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "notes": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/Note"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "meta": {
                "$ref": "#/components/schemas/NotePageMeta"
              }
            }
          }
        }
      },
      "Bookmark": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "is_pinned",
          "is_archived",
          "is_public",
          "click_count",
          "created_at",
          "updated_at",
          "tags"
        ],
        "properties": {
          "id": { "type": "string" },
          "user_id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "description": { "type": ["string", "null"] },
          "cover_image": { "type": ["string", "null"] },
          "favicon": { "type": ["string", "null"] },
          "is_pinned": { "type": "boolean" },
          "is_archived": { "type": "boolean" },
          "is_public": { "type": "boolean" },
          "click_count": { "type": "integer", "minimum": 0 },
          "last_clicked_at": { "type": ["string", "null"] },
          "has_snapshot": { "type": "boolean" },
          "latest_snapshot_at": { "type": ["string", "null"] },
          "notes": {
            "type": "array",
            "description": "列表最多 3 条预览，每条超过 200 个字符会截断；详情最多 50 条完整备注。",
            "items": { "$ref": "#/components/schemas/Note" }
          },
          "note_count": { "type": "integer", "minimum": 0 },
          "snapshot_count": { "type": "integer", "minimum": 0 },
          "screenshot": {
            "oneOf": [{ "$ref": "#/components/schemas/BookmarkScreenshot" }, { "type": "null" }]
          },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "deleted_at": { "type": ["string", "null"] },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BookmarkTag" }
          }
        },
        "additionalProperties": true
      },
      "CreateBookmarkRequest": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "url": { "type": "string", "format": "uri", "maxLength": 2000 },
          "description": { "type": "string", "maxLength": 1000 },
          "cover_image": { "type": "string", "maxLength": 2000 },
          "favicon": { "type": "string", "maxLength": 2000 },
          "tags": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string", "maxLength": 50 }
          },
          "tag_ids": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string" }
          },
          "is_pinned": { "type": "boolean" },
          "is_public": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "UpdateBookmarkRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "url": { "type": "string", "format": "uri", "maxLength": 2000 },
          "description": { "type": ["string", "null"], "maxLength": 1000 },
          "cover_image": { "type": ["string", "null"], "maxLength": 2000 },
          "favicon": { "type": ["string", "null"], "maxLength": 2000 },
          "tags": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string", "maxLength": 50 }
          },
          "tag_ids": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string" }
          },
          "is_pinned": { "type": "boolean" },
          "is_archived": { "type": "boolean" },
          "is_public": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "BookmarkResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["bookmark"],
            "properties": {
              "bookmark": { "$ref": "#/components/schemas/Bookmark" }
            }
          }
        }
      },
      "Tag": {
        "type": "object",
        "required": ["id", "name", "color", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": ["string", "null"] },
          "bookmark_count": { "type": "integer", "minimum": 0 },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        },
        "additionalProperties": true
      },
      "CreateTagRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 50 },
          "color": { "type": ["string", "null"], "maxLength": 20 }
        },
        "additionalProperties": false
      },
      "UpdateTagRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 50 },
          "color": { "type": ["string", "null"], "maxLength": 20 }
        },
        "additionalProperties": false
      },
      "TagResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["tag"],
            "properties": {
              "tag": { "$ref": "#/components/schemas/Tag" }
            }
          }
        }
      },
      "AgentIndexResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "name",
              "version",
              "mode",
              "authentication",
              "documentation",
              "openapi",
              "skill",
              "endpoints"
            ],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "mode": { "const": "read-write" },
              "authentication": { "const": "X-API-Key" },
              "documentation": { "type": "string", "format": "uri" },
              "openapi": { "type": "string", "format": "uri" },
              "skill": { "type": "string", "format": "uri" },
              "endpoints": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["user", "api_key"],
            "properties": {
              "user": {
                "type": "object",
                "required": ["id", "username", "email", "created_at", "stats"],
                "properties": {
                  "id": { "type": "string" },
                  "username": { "type": "string" },
                  "email": { "type": ["string", "null"] },
                  "created_at": { "type": "string" },
                  "stats": {
                    "type": "object",
                    "required": ["total_bookmarks", "pinned_bookmarks", "total_tags"],
                    "properties": {
                      "total_bookmarks": { "type": "integer", "minimum": 0 },
                      "pinned_bookmarks": { "type": "integer", "minimum": 0 },
                      "total_tags": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              },
              "api_key": {
                "type": "object",
                "required": ["id", "permissions"],
                "properties": {
                  "id": { "type": "string" },
                  "permissions": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["query", "results", "meta"],
            "properties": {
              "query": { "type": "string" },
              "results": {
                "type": "object",
                "required": ["bookmarks", "tags"],
                "properties": {
                  "bookmarks": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Bookmark" }
                  },
                  "tags": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Tag" }
                  }
                }
              },
              "meta": {
                "type": "object",
                "required": ["bookmark_count", "tag_count"],
                "properties": {
                  "bookmark_count": { "type": "integer", "minimum": 0 },
                  "tag_count": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      },
      "BookmarkListResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["bookmarks", "meta"],
            "properties": {
              "bookmarks": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Bookmark" }
              },
              "meta": {
                "type": "object",
                "required": ["page_size", "count", "next_cursor", "has_more"],
                "properties": {
                  "page_size": { "type": "integer", "minimum": 1 },
                  "count": { "type": "integer", "minimum": 0 },
                  "next_cursor": { "type": ["string", "null"] },
                  "has_more": { "type": "boolean" }
                }
              }
            }
          }
        }
      },
      "TagListResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["tags"],
            "properties": {
              "tags": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Tag" }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ]
}
