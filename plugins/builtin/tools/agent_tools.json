          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "requiredPermission": "tab_groups.read",
    "write": false,
    "destructive": false
  },
  {
    "name": "markvault_list_tab_notes",
    "title": "读取标签页备注",
