  {
    "name": "markvault_list_bookmark_notes",
    "title": "读取书签备注",
    "description": "分页读取一个书签的全部备注。备注是对该网站的评价和记录（是否需要登录、反爬情况、签到结果等），置顶的排在最前，其余按时间倒序。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "书签 ID"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 30
        },
        "page_cursor": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "requiredPermission": "bookmarks.read",
    "write": false,
    "destructive": false
  },
  {
    "name": "markvault_add_bookmark_note",
    "title": "添加书签备注",
    "description": "给书签追加一条备注，用于记录对该网站的评价、访问要求或操作结果。备注只追加，不会覆盖书签描述和已有备注。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "书签 ID"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "备注正文。写清楚事实和日期，例如“2026-11-18 签到成功，获得 5 积分”。"
        },
        "is_pinned": {
          "type": "boolean",
          "description": "置顶后排在最前面，适合长期有效的结论，例如“必须登录”“反爬严格”。"
        },
        "confirm": {
          "type": "boolean",
          "const": true,
          "description": "只有在用户明确确认本次写操作后才能设为 true。"
        }
      },
      "required": [
        "id",
        "content",
        "confirm"
      ],
      "additionalProperties": false
    },
    "requiredPermission": "bookmarks.note",
    "write": true,
    "destructive": false
  },
  {
    "name": "markvault_list_tab_groups",
