      ],
      "additionalProperties": false
    },
    "requiredPermission": "tags.create",
    "write": true,
    "destructive": false
  },
  {
    "name": "markvault_update_tag",
    "title": "修改标签",
    "description": "修改标签名称或颜色。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "color": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "confirm": {
          "type": "boolean",
          "const": true,
          "description": "只有在用户明确确认本次写操作后才能设为 true。"
        }
      },
      "required": [
        "id",
