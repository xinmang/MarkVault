  {
    "name": "markvault_add_tab_note",
    "title": "添加标签页备注",
    "description": "给标签页组中的一个标签页追加一条备注，用于记录对该网站的评价、访问要求或操作结果。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "标签页 ID，来自标签页组的 items[].id"
        },
        "content": {
          "type": "string",
          "minLength": 1,
