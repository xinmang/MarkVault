{
  "name": "markvault",
  "version": "0.1.0",
  "description": "可自托管的书签、标签页组与网页快照管理工具",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinmang/MarkVault.git"
  },
  "bugs": "https://github.com/xinmang/MarkVault/issues",
  "homepage": "https://github.com/xinmang/MarkVault#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node scripts/go.mjs run",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:plugins:browser": "node scripts/test-plugin-browser.mjs",
    "plugins:runtime": "node scripts/install-deno.mjs",
    "dev:api": "node scripts/go.mjs run",
    "test:api": "node scripts/go.mjs test",
    "build:api": "node scripts/go.mjs build",
    "db:migrate": "node scripts/go.mjs migrate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/query-sync-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.15",
    "date-fns": "^4.4.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.545.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.4",
    "simple-icons": "^15.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "yaml@<2.8.3": "^2.8.3"
    }
  }
}
